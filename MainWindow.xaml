<Window x:Class="UtLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UtLoader.ViewModels"
        Title="UtLoader" Height="750" Width="650"
        MinHeight="500" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E4E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Video or Playlist URL:" FontWeight="SemiBold" Foreground="#333" Margin="0,0,0,5"/>
                <TextBox Height="30" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="6,0" VerticalContentAlignment="Center" FontSize="14" Margin="0,0,0,15"
                         BorderBrush="#CCC" Background="#FAFAFA"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Format:" FontWeight="SemiBold" Foreground="#333" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="MP3" GroupName="FormatOptions" IsChecked="{Binding IsMp3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="MP4" GroupName="FormatOptions" IsChecked="{Binding IsMp4}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton Content="Native" GroupName="FormatOptions" IsChecked="{Binding IsNative}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBox Grid.Column="1" Text="{Binding OutputPath}" IsReadOnly="True" 
                             Height="30" Padding="6,0" VerticalContentAlignment="Center" Background="#F8F9FA" BorderBrush="#DDD"/>
                    <Button Grid.Column="2" Content="Browse..." Width="80" Height="30" Margin="10,0,0,0" 
                            Command="{Binding BrowseCommand}" Cursor="Hand" Background="#E9ECEF" BorderBrush="#CCC"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,20">
            <Button Content="Download" Command="{Binding DownloadCommand}" Width="180" Height="36" 
                    FontWeight="Bold" FontSize="14" Background="#0078D4" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" Width="130" Height="36" Margin="15,0,0,0" 
                    FontWeight="Bold" FontSize="14" Background="#FFB900" Foreground="#333" BorderThickness="0" Cursor="Hand"/>

            <Button Content="Stop All" Command="{Binding StopCommand}" Width="100" Height="36" Margin="15,0,0,0" 
                    FontWeight="Bold" FontSize="14" Background="#D13438" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" BorderBrush="#0078D4" BorderThickness="1,1,1,3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0" Height="10" Maximum="100" Value="{Binding Progress}" Margin="0,0,0,12" 
                             Foreground="#0078D4" Background="#E1E4E8" BorderThickness="0"/>

                <TextBlock Grid.Row="1" Text="{Binding Status}" FontWeight="Bold" FontSize="15" Foreground="#0078D4" Margin="0,0,0,8"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding FileName, StringFormat='File: {0}'}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" Foreground="#555"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding FileSize, StringFormat='Size: {0}'}" Foreground="#777" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding Format, StringFormat='Format: {0}'}" Foreground="#777"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,0,0,5"
                Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding PlaylistItems.Count, StringFormat='Playlist Queue ({0} Tracks)'}" 
                           FontWeight="Bold" FontSize="15" Foreground="#333" Margin="0,0,0,10"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Height="28" Padding="6,0" VerticalContentAlignment="Center" Background="#FAFAFA" BorderBrush="#CCC" Margin="0,0,15,0"/>
                    <CheckBox Grid.Column="1" Content="Select All" IsChecked="{Binding SelectAll}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#444"/>
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredPlaylistItems}" 
                         BorderBrush="#E1E4E8" BorderThickness="1" Background="#FAFAFA"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="8,10" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" x:Name="TrackCheckBox" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" x:Name="TrackTitle" TextWrapping="Wrap" Margin="10,0,15,0" Foreground="#222" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}" x:Name="TrackStatus" FontWeight="Bold" Foreground="#0078D4" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Finished!">
                                    <Setter TargetName="TrackTitle" Property="Foreground" Value="#AAA"/>
                                    <Setter TargetName="TrackStatus" Property="Foreground" Value="#107C10"/>
                                    <Setter TargetName="TrackStatus" Property="Text" Value="✓ Finished"/>
                                    <Setter TargetName="TrackCheckBox" Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                                    <Setter TargetName="TrackTitle" Property="Foreground" Value="#AAA"/>
                                    <Setter TargetName="TrackStatus" Property="Foreground" Value="#AAA"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="3" Content="▶ Start Playlist Download" Command="{Binding StartPlaylistCommand}" 
                        Height="40" FontWeight="Bold" FontSize="14" Background="#107C10" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,5,0,0">
            <TextBlock Text="UTL" FontWeight="Bold" HorizontalAlignment="Left" Foreground="#CCC" FontSize="11"/>
            <TextBlock Text="by Murat Khabriev" HorizontalAlignment="Right" Foreground="#AAA" FontSize="11"/>
        </Grid>
    </Grid>
</Window>